{
  // Conductor plan for Shamshir — iter-parity-pipeline.
  //
  // DRIVER: the stable C:\Code\conductor\bin\conductor.exe.
  // REPO: C:\Code\Shamshir on branch iter/parity-pipeline (create it off
  //   iter/quant-model--p1-tf-agnostic before running — see the run steps).
  //
  // Authority docs: PLAN.md (durable spec), AUDIT.md (F1-F16 findings). This file only tells
  // conductor where progress lives (TRACKER.md) and how to spawn/verify sessions.
  "name": "Shamshir-Parity",
  "repo": "C:/Code/Shamshir",
  "tracker": "docs/iterations/iter-parity-pipeline/TRACKER.md",
  "planDoc": "docs/iterations/iter-parity-pipeline/PLAN.md",
  "branchPattern": "^iter/parity-pipeline",
  "pauseOnBlocked": true,

  "agent": {
    "command": "opencode",
    "args": [
      "run", "-m", "deepseek/deepseek-v4-pro", "--auto", "--thinking", "--share", "--format", "json", "{prompt}"
    ],
    "resumeArgs": [
      "run", "-m", "deepseek/deepseek-v4-pro", "--auto", "--thinking", "--share", "--format", "json", "--continue", "{prompt}"
    ],
    "output": "opencode-json"
  },

  // Free the build servers between the build gate and the test gate (DLL locks). We do NOT kill
  // dotnet broadly (that would kill the gate run itself). The cTrader test harness reaps its own
  // child ctrader-cli processes; if strays appear, add a targeted teardown later.
  "setup": {
    "command": "dotnet build-server shutdown; exit 0",
    "timeoutMinutes": 2
  },
  "teardown": {
    "command": "dotnet build-server shutdown; exit 0",
    "timeoutMinutes": 2
  },

  "advisor": {
    "enabled": true,
    "command": "opencode",
    "args": ["run", "{prompt}", "-m", "deepseek/deepseek-v4-pro"],
    "output": "text",
    "timeoutMinutes": 6
  },

  // Stages P0..P6 (TRACKER uses P0.0 for PLAN's "P-0"). Session counts are rough from PLAN's
  // sizing; attempt budget = sessions * limits.stageSlackFactor. P2 carries the owner-gated
  // headline checkpoint P2.2 — it will legitimately BLOCK for owner approval/credentials.
  "stages": [
    { "id": "P0", "title": "Parity truth repair (the spine)",      "sessions": 3, "notes": "Read PLAN.md sections 2-3 and AUDIT.md F1/F2/F5/F6. P0.0 lands the tree in 3 deliberate commits (revert 8 JSONs to Market per Q1). P0.1 ¼-sizing: VenueSizingParityTests via FakeTransport (NO cTrader credentials needed). Golden fixtures WILL move on P0.1 — do a SEPARATE rebaseline commit. Evidence or it didn't happen." },
    { "id": "P1", "title": "Config & DB truth",                    "sessions": 2, "notes": "Read PLAN.md section 4 + AUDIT F7/F9/F10. Prove config propagation in the RUNTIME store (DB query / journal evidence), not the source file (R5)." },
    { "id": "P2", "title": "Lifecycle robustness + headline gate", "sessions": 2, "notes": "Read PLAN.md section 5 + AUDIT F8/F16. P2.2 is the OWNER-GATE: one real compare-both run + committed reconcile verdict. It needs cTrader credentials + owner sign-off — set the row BLOCKED with a HUMAN: line in the handoff when you reach it; do not fake it." },
    { "id": "P3", "title": "Research pipeline (ResearchCli + playbooks)", "sessions": 3, "notes": "Read PLAN.md section 6. Do not start until P2.2 is owner-approved. Keep the playbook engine a dumb sequential executor with persisted verdicts (no DAGs/retries in v1)." },
    { "id": "P4", "title": "Lab golden paths",                     "sessions": 2, "notes": "Read PLAN.md section 7. Needs P0 (trusted excursions) + P3 (playbook)." },
    { "id": "P5", "title": "UI truth + Angular refactor",          "sessions": 2, "notes": "Read PLAN.md section 8. Each UI fix gates on one driven smoke via the run-shamshir skill (R6)." },
    { "id": "P6", "title": "Wild list (pipeline-gated)",           "sessions": 2, "notes": "Read PLAN.md section 9. Only start once playbooks (1)-(3) run green; each feature ships with a measuring playbook." }
  ],

  "gatePolicy": "perPhase",

  // Audit fixes leftovers, not just documents them (see conductor self-plan philosophy). After a
  // phase's full battery is green, the audit reviews the diff, fixes shallow impls / edge cases /
  // bugs within budget, re-verifies, and writes an honest handover; deferred items are tracked.
  "audit": { "enabled": true, "maxAttempts": 1 },

  // Gates: real exit codes only, matching Shamshir's actual commands.
  //  - build: fast tier (also per session) — full solution, 0 errors is the bar.
  //  - unit: fast unit suite.
  //  - sim-fast: the fast Simulation filter (cTrader E2E/Slow/NetMQ excluded — slow & flaky per
  //    PROGRESS.md; credentials-free). This is the durable parity/golden gate.
  //  - web-tsc: Angular type check, only on UI phases (P5), skipped if web-ui is absent.
  // The cTrader-inclusive full suite (P2.2 compare-both) is an owner-driven step, not an automated
  // gate — it's the owner-gate checkpoint, run with credentials under supervision.
  "gates": [
    { "name": "build",    "command": "dotnet build TradingEngine.slnx", "tier": "fast", "timeoutMinutes": 15 },
    { "name": "unit",     "command": "dotnet test tests/TradingEngine.Tests.Unit", "parallel": true, "timeoutMinutes": 20 },
    { "name": "sim-fast", "command": "dotnet test tests/TradingEngine.Tests.Simulation --filter \"RequiresCTrader!=true&Category!=E2E&Category!=Slow&Category!=NetMQ\"", "parallel": true, "timeoutMinutes": 30 },
    { "name": "web-tsc",  "command": "npx tsc --noEmit", "cwd": "web-ui", "stages": ["P5"], "skipIfMissing": "web-ui/package.json", "timeoutMinutes": 10 }
  ],

  "limits": {
    "stallMinutes": 15,
    "sessionTimeoutMinutes": 240,
    "maxResumesPerSession": 2,
    "stageSlackFactor": 2,
    "backoffMinutes": 30,
    "maxBackoffs": 10
  },

  "report": { "commit": true, "push": false, "heartbeatMinutes": 15 },

  "notify": { "command": "", "args": [] },

  "statusAgent": {
    "enabled": true,
    "command": "opencode",
    "args": ["run", "{prompt}", "-m", "deepseek/deepseek-v4-pro"],
    "timeoutMinutes": 5
  },

  "templatesDir": "shamshir-templates",
  "promptExtra": "Shamshir meta-rule: a deferred gate means the phase is NOT done. Evidence or it didn't happen — paste the command + output; verify config claims in the RUNTIME store (DB/journal), not the source file. One subphase = one commit. Do NOT use DateTime.UtcNow (use IEngineClock); Serilog message templates only (no Console.WriteLine); decimal + Math.Floor for money/lots. Golden must stay byte-identical unless a checkpoint explicitly rebaselines — then a SEPARATE rebaseline commit. When you reach an owner-gate (P2.2) or need cTrader credentials, set the row BLOCKED, add a HUMAN: line to the handoff, commit, and stop — do not fabricate a result."
}
