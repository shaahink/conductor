{
  "name": "conductor-face",
  "version": "0.1.0",
  "description": "F6: Ink TUI client for the Conductor control plane — panes + palette per docs/CONDUCTOR-VNEXT-PLAN.md D11.",
  "private": true,
  "type": "module",
  "bin": {
    "conductor-face": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/cli.tsx --demo",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
