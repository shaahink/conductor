<!-- Central build properties for all projects (B0.1).
     Common TFM + modern-C# knobs live here so every project inherits one source of truth.
     Analyzers + warnings-as-errors + curated ruleset land in B0.2 (see .editorconfig / ADR-0001). -->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Deterministic, reproducible builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Quality gates (B0.2): analyzers on, style enforced in build, curated severities in .editorconfig.
         Warnings are errors — the build gate is the quality gate (BATON-BRIEF §5.1). -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Complexity budgets (KS6.3). CA1502/CA1505/CA1506 read their thresholds from an AdditionalFile
       named CodeMetricsConfig.txt, and the budget is PER PROJECT because the numbers are per project:
       Conductor.Planning holds a cyclomatic budget of 10 while Conductor.Core carries 91, and one
       repo-wide number would have to be the loosest of them. A project with no such file silently
       falls back to the analyzer defaults (25/10/95), which is a loosening for every project here -
       tools/gates/complexity-budget.ps1 refuses a missing file for exactly that reason. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/CodeMetricsConfig.txt"
                     Condition="Exists('$(MSBuildProjectDirectory)/CodeMetricsConfig.txt')" />
  </ItemGroup>

  <!-- Analyzers applied to every project (version pinned in Directory.Packages.props). -->
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Roslynator (KS6.1). The package enables ~200 rules by default; .editorconfig sets
         roslynator_analyzers.enabled_by_default = false and re-enables a curated design-shaped set
         by name. Curation is the deliverable - see AnalyzerCurationTests, which is what stops it
         drifting back into a wall of noise. -->
    <PackageReference Include="Roslynator.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
