<!-- Central package version management (B0.1).
     ManagePackageVersionsCentrally: projects reference packages without a Version; versions live here.
     Additional packages (analyzers B0.2; Host/DI/Serilog B2) are added when first consumed. -->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Analyzers (B0.2) -->
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.207" />
    <!-- Roslynator (KS6.1): shipped OFF by default, ~25 design-shaped rules turned on by name in .editorconfig. -->
    <PackageVersion Include="Roslynator.Analyzers" Version="4.16.1" />

    <!-- Versioning (SC8.2): tag height decides the version, no human types one. Build-only. -->
    <PackageVersion Include="MinVer" Version="7.0.0" />

    <!-- Runtime -->
    <PackageVersion Include="Spectre.Console" Version="0.49.1" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.49.1" />

    <!-- Host / DI / Options / structured logging (B2.5) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />

    <!-- Test -->
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
