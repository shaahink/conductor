<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>conductor</AssemblyName>
    <RootNamespace>Conductor</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>conductor</ToolCommandName>
    <PackageId>conductor</PackageId>
    <PackageDescription>A stateful execution environment for days-long AI software engineering — one verifiable session at a time.</PackageDescription>
    <PackageTags>dotnet-tool;ai-agent;orchestration;code-generation</PackageTags>
    <RepositoryUrl>https://github.com/shahabaz/conductor</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- K2.1: this project is the CLI (Spectre commands, Program.cs) plus HOSTING (ConductorHost, the
         HttpListener control plane). Everything else - domain, orchestration, store, providers - lives in
         Conductor.Core, which does not reference this assembly. That is the whole point: the direction is
         now a compiler error, not a review comment.
         P0: the planning library is referenced transitively through Core and stays engine-free.
         The global usings keep the moved vocabulary available without churning every file. -->
    <ProjectReference Include="..\Conductor.Core\Conductor.Core.csproj" />
    <Using Include="Conductor.Planning" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shell's own dependencies: the CLI framework it is written in and the logging sinks the host
         configures. SQLite and the store's migration resources moved to Conductor.Core with the store
         itself and flow here transitively. -->
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conductor.Tests" />
  </ItemGroup>

  <!-- SC8.1/SC8.2: MinVer + the commit/date stamp, shared with Conductor.Core because BuildInfo
       lives there now and reads its own assembly's attributes. See src/BuildStamp.targets. -->
  <Import Project="..\BuildStamp.targets" />

</Project>
