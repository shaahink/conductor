<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>conductor</AssemblyName>
    <RootNamespace>Conductor</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>conductor</ToolCommandName>
    <PackageId>conductor</PackageId>
    <Version>2.0.0</Version>
    <PackageDescription>A stateful execution environment for days-long AI software engineering — one verifiable session at a time.</PackageDescription>
    <PackageTags>dotnet-tool;ai-agent;orchestration;code-generation</PackageTags>
    <RepositoryUrl>https://github.com/shahabaz/conductor</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- P0: the engine depends on the planning library, NEVER the reverse (arch-test enforced).
         The global using keeps the moved planning vocabulary (SessionKind, Workflow*) available
         everywhere without churning every file that already spoke it. -->
    <ProjectReference Include="..\Conductor.Planning\Conductor.Planning.csproj" />
    <Using Include="Conductor.Planning" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Core\Store\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Conductor.Tests" />
  </ItemGroup>

</Project>
