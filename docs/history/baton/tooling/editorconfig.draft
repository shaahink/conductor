# B0 DRAFT -> promote to repo-root .editorconfig in checkpoint B0.2.
# Style + analyzer severities. Curated, not the raw firehose (rationale: meziantou-ruleset.md / ADR-0001).
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,ps1}]
indent_size = 2

[*.cs]
# --- Language / style conventions (modern C#) ---
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_sort_system_directives_first = true
dotnet_style_namespace_match_folder = true:suggestion

# --- .NET analyzers (CA) — key correctness rules as errors ---
dotnet_diagnostic.CA2007.severity = error   # ConfigureAwait(false) in library code
dotnet_diagnostic.CA2016.severity = error   # forward CancellationToken
dotnet_diagnostic.CA1849.severity = error   # call async methods when in an async method
dotnet_diagnostic.CA2000.severity = warning # dispose objects before losing scope
dotnet_diagnostic.CA1063.severity = warning # implement IDisposable correctly
dotnet_diagnostic.CA1031.severity = warning # do not catch general exception types (no silent catch)
dotnet_diagnostic.CA1051.severity = suggestion

# --- Meziantou analyzers (MA) — curated; see meziantou-ruleset.md ---
dotnet_diagnostic.MA0004.severity = error   # use ConfigureAwait(false)
dotnet_diagnostic.MA0040.severity = error   # forward the CancellationToken
dotnet_diagnostic.MA0042.severity = error   # do not use blocking calls in async (no .Result/.Wait())
dotnet_diagnostic.MA0045.severity = warning # do not use blocking on async (sync-over-async)
dotnet_diagnostic.MA0079.severity = error   # forward CancellationToken using .WithCancellation
dotnet_diagnostic.MA0134.severity = warning # observe result of Task-returning methods (no floating tasks)
dotnet_diagnostic.MA0006.severity = suggestion # use String.Equals instead of ==
dotnet_diagnostic.MA0011.severity = warning # IFormatProvider is missing
dotnet_diagnostic.MA0016.severity = suggestion # prefer returning collection abstraction
dotnet_diagnostic.MA0051.severity = suggestion # method is too long (advisory)
